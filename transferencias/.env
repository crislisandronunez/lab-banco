# Aplicación
SPRING_APPLICATION_NAME=transferencias
APP_PORT=8080

# Docker
COMPOSE_PROJECT_NAME=lab-transferencias
DOCKER_NETWORK_NAME=transferencias-network
RESTART_POLICY=unless-stopped

# Healthchecks
HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# PostgreSQL
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=transferencias-postgres
POSTGRES_HOST=localhost
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=transfer_db
POSTGRES_USER=transferencias
POSTGRES_PASSWORD=admin
POSTGRES_VOLUME_NAME=transferencias-postgres-data

# Pool de conexiones
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# Kafka
KAFKA_IMAGE=apache/kafka
KAFKA_VERSION=4.4.0
KAFKA_CONTAINER_NAME=transferencias-kafka
KAFKA_HOST=localhost
KAFKA_BIND_HOST=127.0.0.1
KAFKA_EXTERNAL_PORT=9092
KAFKA_CLIENT_PORT=9092
KAFKA_BROKER_PORT=19092
KAFKA_CONTROLLER_PORT=29093
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_START_PERIOD=30s
KAFKA_VOLUME_NAME=transferencias-kafka-data

# Keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
KEYCLOAK_VERSION=26.8.1
KEYCLOAK_CONTAINER_NAME=transferencias-keycloak
KEYCLOAK_BIND_HOST=127.0.0.1
KEYCLOAK_EXTERNAL_PORT=8081
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_REALM=transferencias
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PROMETHEUS_CLIENT_ID=transferencias-prometheus
KEYCLOAK_PROMETHEUS_CLIENT_SECRET=admin
KEYCLOAK_VOLUME_NAME=transferencias-keycloak-data

# Prometheus
PROMETHEUS_IMAGE=prom/prometheus
PROMETHEUS_VERSION=v3.5.5
PROMETHEUS_CONTAINER_NAME=transferencias-prometheus
PROMETHEUS_BIND_HOST=127.0.0.1
PROMETHEUS_EXTERNAL_PORT=9090
PROMETHEUS_INTERNAL_PORT=9090
PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION=15d
PROMETHEUS_VOLUME_NAME=transferencias-prometheus-data

# Grafana
GRAFANA_IMAGE=grafana/grafana
GRAFANA_VERSION=12.1.1
GRAFANA_CONTAINER_NAME=transferencias-grafana
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_EXTERNAL_PORT=3000
GRAFANA_INTERNAL_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_VOLUME_NAME=transferencias-grafana-data